{
  "workload": {
    "workload_file": "../test/{dbname}_test.sql",
    "output_file": "./feature/{dbname}_workload_features.json"
  },
  "database": {
    "host": "/path/to/postgresql/run",
    "port": 5432,
    "user": "postgres",
    "password": "",
    "dbname": "TPCDS"
  },
