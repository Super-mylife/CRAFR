    "max_llm_calls": 16,
    "local_candidate_limit": 12,
    "total_tuning_time_seconds": 0,
    "statement_timeout_seconds": 600,
    "max_physical_trials": 3,
    "max_additions": 2,
    "max_removals": 2  },
  "llm": {
    "api_key": "xxxx",
    "base_url": "xxxxx",
    "model": "gpt-4.1"
  }
}
